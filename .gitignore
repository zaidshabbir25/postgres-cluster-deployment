# --- secrets -----------------------------------------------------------------
# The real inventory carries hostnames, usernames and key paths.
configuration/inventory.json

# Private keys, never.
keys/*
!keys/.gitkeep
*.pem
*.key
id_rsa*
id_ed25519*

# --- runtime output ----------------------------------------------------------
# Deployment state: regenerated by every deploy, and describes live machines.
configuration/clusters/

logs/*
!logs/.gitkeep

reports/runs/
reports/index.html

# --- python ------------------------------------------------------------------
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- editors and platforms ---------------------------------------------------
.DS_Store
*.swp
.idea/
.vscode/*
!.vscode/settings.json
