# Version pins for PostgreSQL 18 deployments.
#
# These are reference points, not gates: the deployment installs whatever the
# selected pgEdge channel offers and records the result in the report. The pins
# are what a report is compared against when you need to answer "was this run
# the same as last week's?".
#
# Used by aspects/inventory.py:expected_versions(). Editing a value here does
# not change what gets installed — use --channel or a source build for that.

export PG_VERSION=18.6
export PG_MAJOR_VERSION=18

# Spock. Only one major is installed per cluster, chosen with --spock-major.
export PGEDGE_SPOCK50_18_VERSION=5.0.11
export PGEDGE_SPOCK60_18_VERSION=6.0.0

# High availability stack.
export PGEDGE_PATRONI_VERSION=4.1.3-2
export PGEDGE_ETCD_VERSION=3.6.8

# zodan cross-wiring script per Spock major. spock60 renamed catalog columns,
# so it needs its own revision — see configuration/spock/README.md.
export ZODAN_SQL_SPOCK50=zodan-511.sql
export ZODAN_SQL_SPOCK60=zodan-600.sql
